# Copy this file to .env.local and fill in your real values.
#
# Both variables below are NEXT_PUBLIC_ — they are compiled into the JavaScript
# bundle and visible to anyone who views source. That is fine, and deliberate:
# the site is a static export with no server, so nothing secret can live in it.
# The actual secret (the Turnstile secret key) sits in the Apps Script project
# instead, where the browser cannot reach it. See
# scripts/google-apps-script-webhook.gs

# The URL you get after deploying the Google Apps Script as a Web App
# (Extensions -> Apps Script -> Deploy -> New deployment -> Web app).
# Publicly reachable by design; it refuses any request without a Turnstile
# token that Cloudflare confirms, so knowing the URL is not enough to write.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Site Key from Cloudflare dashboard -> Turnstile -> your widget. Meant to be
# public. Its matching Secret Key goes in the Apps Script's script properties
# as TURNSTILE_SECRET, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key

# Optional. Set to 1 to keep a production build out of search engines — for a
# staging copy or a branch preview on a throwaway URL.
# NEXT_PUBLIC_SITE_NOINDEX=1

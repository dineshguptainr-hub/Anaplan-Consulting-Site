# Copy this file to .env.local and fill in your real values.
# Never commit real values — this repo's history is public and cannot be
# scrubbed after the fact.

# The URL you get after deploying the Google Apps Script as a Web App
# (Extensions -> Apps Script -> Deploy -> New deployment -> Web app).
# The script source lives at scripts/google-apps-script-webhook.gs
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared secret sent with every submission. Must match the WEBHOOK_SECRET
# script property in the Apps Script project (Project Settings -> Script
# properties) or the script refuses the write. This is what stops a leaked
# deployment URL from being enough to append rows to the Sheet.
CONTACT_WEBHOOK_SECRET=a-long-random-string

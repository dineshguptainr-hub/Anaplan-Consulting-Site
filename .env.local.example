# Copy this file to .env.local and fill in your real value.
# This is the URL you get after deploying the Google Apps Script as a Web App
# (Extensions -> Apps Script -> Deploy -> New deployment -> Web app).
# The script source lives at scripts/google-apps-script-webhook.gs
#
# Never commit the real deployment URL — anyone holding it can append rows to
# the Sheet.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
